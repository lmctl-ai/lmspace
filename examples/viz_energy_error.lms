# Energy error of an eccentric orbit (e = 0.6, semi-major axis 1, 50 periods) for the two integrators: fixed-step
# symplectic leapfrog (bounded error that scales with dt squared) and adaptive Dormand-Prince RK45 at two tolerances.
# The planet has almost no mass, so the Sun stays at the origin and E = v^2/2 - 1/r per unit mass.
# Output: images/energy_error.png   (run: lmctl autorun <raw url of this file>)
mkdir("build/examples");
mkdir("images");
sim = _lmcode_ cli="lmspace" install="github:lmctl-ai/lmspace@latest";
let sun_e1 = space.body("sun", 1.0);
let pl_e1 = space.body("planet", 0.000000000001, 0.4, 0.0, 0.0, 0.0, 2.0, 0.0);
let o_e1 = space.system().add(sun_e1).add(pl_e1).propagate(314.159265358979, 600, 0.02, "symplectic", 0.000000001);
o_e1.save_csv("build/examples/energy_e1.csv");
let sun_e2 = space.body("sun", 1.0);
let pl_e2 = space.body("planet", 0.000000000001, 0.4, 0.0, 0.0, 0.0, 2.0, 0.0);
let o_e2 = space.system().add(sun_e2).add(pl_e2).propagate(314.159265358979, 600, 0.005, "symplectic", 0.000000001);
o_e2.save_csv("build/examples/energy_e2.csv");
let sun_e3 = space.body("sun", 1.0);
let pl_e3 = space.body("planet", 0.000000000001, 0.4, 0.0, 0.0, 0.0, 2.0, 0.0);
let o_e3 = space.system().add(sun_e3).add(pl_e3).propagate(314.159265358979, 600, 0.1, "rk45", 0.000000010000000);
o_e3.save_csv("build/examples/energy_e3.csv");
let sun_e4 = space.body("sun", 1.0);
let pl_e4 = space.body("planet", 0.000000000001, 0.4, 0.0, 0.0, 0.0, 2.0, 0.0);
let o_e4 = space.system().add(sun_e4).add(pl_e4).propagate(314.159265358979, 600, 0.1, "rk45", 0.000000000001000);
o_e4.save_csv("build/examples/energy_e4.csv");
assert_close(sqrt(1.0), 1.0, 0.0);
end _lmcode_
savedsl(sim, "build/viz_energy_error-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode build/viz_energy_error-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/energy_error.png", 900, 560);
plot.cmd("set datafile separator ','");
plot.cmd("set title 'Energy error over 50 orbits (e = 0.6): symplectic leapfrog vs adaptive RK45'");
plot.cmd("set xlabel 'time [orbital periods]'");
plot.cmd("set ylabel '|E(t) - E(0)|  (log scale)'");
plot.cmd("set logscale y");
plot.cmd("set format y '10^{%L}'");
plot.cmd("set yrange [1e-14:1]");
plot.cmd("set grid");
plot.cmd("set key bottom right box opaque");
plot.cmd("set xtics ('0' 0, '10' 62.83185307, '20' 125.6637061, '30' 188.4955592, '40' 251.3274123, '50' 314.159265358979)");
plot.cmd("e0 = 0.5*2.0**2 - 1.0/0.4");
plot.cmd("plot 'build/examples/energy_e1.csv' using 1:(abs(0.5*($11**2+$12**2)-1.0/sqrt($8**2+$9**2)-e0)+1e-17) with lines lw 2 lc rgb '#d62728' title 'leapfrog dt = 0.02', 'build/examples/energy_e2.csv' using 1:(abs(0.5*($11**2+$12**2)-1.0/sqrt($8**2+$9**2)-e0)+1e-17) with lines lw 2 lc rgb '#ff7f0e' title 'leapfrog dt = 0.005', 'build/examples/energy_e3.csv' using 1:(abs(0.5*($11**2+$12**2)-1.0/sqrt($8**2+$9**2)-e0)+1e-17) with lines lw 2 lc rgb '#2ca02c' title 'RK45 tol 1e-8', 'build/examples/energy_e4.csv' using 1:(abs(0.5*($11**2+$12**2)-1.0/sqrt($8**2+$9**2)-e0)+1e-17) with lines lw 2 lc rgb '#1f77b4' title 'RK45 tol 1e-12'");
plot.close();
end _lmcode_
savedsl(draw, "build/energy_error-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode build/energy_error-draw.dslb;
assert(r.code == 0);
println("wrote images/energy_error.png");
