# Trojan asteroids: the restricted three-body problem with a Sun-Jupiter mass ratio of 0.001 (G = 1, distance 1, period 2 pi).
# Three light asteroids start near Jupiter's L4 point, 60 degrees ahead of the planet on the same orbit, with the circular
# speed: in the frame that rotates with Jupiter they do not stay put, they librate around L4 on long banana-shaped tadpole
# orbits (the classic Trojans); the closer the start to L4, the smaller the orbit. lmspace integrates
# 5 bodies with RK45 at 1e-11 for 150 time units (24 Jupiter years); the script asserts that each asteroid keeps the orbital
# radius of Jupiter within 10 per cent, and lmplot draws them in the rotating frame (x', y') = R(-t) (x, y).
# Output: images/trojans.png   (run: lmctl autorun <raw url of this file>)
mkdir("build/examples");
mkdir("images");
sim = _lmcode_ cli="lmspace" install="github:lmctl-ai/lmspace@latest";
let mj = 0.001;
let sun = space.body("sun", 1.0 - mj, 0.0 - mj, 0.0, 0.0, 0.0, 0.0 - mj, 0.0);
let jup = space.body("jupiter", mj, 1.0 - mj, 0.0, 0.0, 0.0, 1.0 - mj, 0.0);
let a1 = space.body("a1", 0.0000000000001, 0.0 - mj + cos(1.0471975511965976 + 0.12), sin(1.0471975511965976 + 0.12), 0.0, 0.0 - sin(1.0471975511965976 + 0.12), cos(1.0471975511965976 + 0.12), 0.0);
let a2 = space.body("a2", 0.0000000000001, 0.0 - mj + cos(1.0471975511965976 - 0.45), sin(1.0471975511965976 - 0.45), 0.0, 0.0 - sin(1.0471975511965976 - 0.45), cos(1.0471975511965976 - 0.45), 0.0);
let a3 = space.body("a3", 0.0000000000001, 0.0 - mj + cos(0.55), sin(0.55), 0.0, 0.0 - sin(0.55), cos(0.55), 0.0);
let out = space.system().add(sun).add(jup).add(a1).add(a2).add(a3).propagate(150.0, 3001, 0.01, "rk45", 0.00000000001);
for (k in range(0, 3001)) {
  let r1 = sqrt(out.get(k, 13) * out.get(k, 13) + out.get(k, 14) * out.get(k, 14));
  let r2 = sqrt(out.get(k, 19) * out.get(k, 19) + out.get(k, 20) * out.get(k, 20));
  let r3 = sqrt(out.get(k, 25) * out.get(k, 25) + out.get(k, 26) * out.get(k, 26));
  assert_close(r1, 1.0, 0.1);
  assert_close(r2, 1.0, 0.1);
  assert_close(r3, 1.0, 0.1);
}
out.save_csv("build/examples/trojans.csv");
end _lmcode_
savedsl(sim, "build/viz_trojans-sim.dslb");
r = system ${dsl_cli(sim)} --dsl build/viz_trojans-sim.dslb;
if (r.code != 0) { println(r.stdout); }
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/trojans.png", 900, 760);
plot.cmd("set datafile separator ','");
plot.cmd("set title 'Trojan asteroids in the frame rotating with Jupiter (lmspace, 24 Jupiter years)'");
plot.cmd("set xlabel \"x' [Jupiter distance]\"");
plot.cmd("set ylabel \"y' [Jupiter distance]\"");
plot.cmd("set size ratio -1");
plot.cmd("set xrange [-0.7:1.35]");
plot.cmd("set yrange [-1.2:1.2]");
plot.cmd("set grid");
plot.cmd("set key outside bottom center horizontal");
plot.cmd("set object 1 circle at 0,0 size 0.05 fc rgb '#ffcc00' fillstyle solid border rgb 'black'");
plot.cmd("set object 2 circle at 1,0 size 0.03 fc rgb '#d2691e' fillstyle solid border rgb 'black'");
plot.cmd("set label 1 'Sun' at 0.0,-0.1 center");
plot.cmd("set label 2 'Jupiter' at 1.0,-0.09 center");
plot.cmd("set label 3 'L4' at 0.5,0.72 center");
plot.cmd("set label 4 'L5' at 0.5,-0.72 center");
plot.cmd("set object 3 circle at 0.5,0.8660254 size 0.012 fc rgb 'black' fillstyle solid");
plot.cmd("set object 4 circle at 0.5,-0.8660254 size 0.012 fc rgb 'black' fillstyle solid");
plot.cmd("set arrow 1 from 0,0 to 0.5,0.8660254 nohead dt 3 lc rgb 'gray50'");
plot.cmd("set arrow 2 from 1,0 to 0.5,0.8660254 nohead dt 3 lc rgb 'gray50'");
plot.cmd("set arrow 3 from 0,0 to 0.5,-0.8660254 nohead dt 3 lc rgb 'gray50'");
plot.cmd("set arrow 4 from 1,0 to 0.5,-0.8660254 nohead dt 3 lc rgb 'gray50'");
plot.cmd("rx(x,y,t) = x*cos(t) + y*sin(t)");
plot.cmd("ry(x,y,t) = -x*sin(t) + y*cos(t)");
plot.cmd("plot 'build/examples/trojans.csv' skip 1 using (rx($14,$15,$1)):(ry($14,$15,$1)) with lines lw 1.5 lc rgb '#1f77b4' title 'start 7 deg ahead of L4', '' skip 1 using (rx($20,$21,$1)):(ry($20,$21,$1)) with lines lw 1.5 lc rgb '#d62728' title 'starts 26 deg behind L4', '' skip 1 using (rx($26,$27,$1)):(ry($26,$27,$1)) with lines lw 1.5 lc rgb '#2ca02c' title 'starts 31 deg from Jupiter'");
plot.close();
end _lmcode_
savedsl(draw, "build/viz_trojans-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/viz_trojans-draw.dslb;
assert(r.code == 0);
println("wrote images/trojans.png");
