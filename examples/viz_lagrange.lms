# Lagrange points of the Earth-Moon system (circular restricted three-body problem, mass ratio mu = 0.01215).
# lmspace's script finds L1, L2 and L3 with Newton's method on the x axis, places L4 and L5 at the equilateral
# points, and computes each point's Jacobi constant; the asserts compare all of them with the textbook values
# (L1 = 0.8369, L2 = 1.1557, L3 = -1.0051; C1 = 3.1883, C2 = 3.1722, C3 = 3.0121, C4 = 2.9880). It then checks
# stability the hard way: a test particle released at rest (in the rotating frame) 1e-6 away from L1 and one
# 0.02 away from L4 are integrated with the Earth and the Moon by lmspace's N-body RK45 for ten months. The L1
# particle departs exponentially (it leaves within a few weeks), the L4 particle librates on a tadpole and stays.
# lmplot draws the forbidden regions (zero-velocity curves), the paths in the rotating frame and the distances.
# Output: images/lagrange.png   (run: lmctl autorun <raw url of this file>)
mkdir("build/examples");
mkdir("images");
sim = _dsl_ cli="lmspace" install="github:lmctl-ai/lmspace@latest";
let mu = 0.01215058560962404;
# collinear points: Newton on dOmega/dx = 0 along the x axis, with a numerical derivative
let lx1 = 0.8;
let lx2 = 1.2;
let lx3 = -1.0;
for (p in range(0, 3)) {
  let x = lx1;
  if (p == 1) { x = lx2; }
  if (p == 2) { x = lx3; }
  for (it in range(0, 40)) {
    let h = 0.000001;
    let d1 = abs(x + mu);
    let d2 = abs(x - 1.0 + mu);
    let f = x - (1.0 - mu) * (x + mu) / pow(d1, 3.0) - mu * (x - 1.0 + mu) / pow(d2, 3.0);
    let e1 = abs(x + h + mu);
    let e2 = abs(x + h - 1.0 + mu);
    let fh = x + h - (1.0 - mu) * (x + h + mu) / pow(e1, 3.0) - mu * (x + h - 1.0 + mu) / pow(e2, 3.0);
    x = x - f * h / (fh - f);
  }
  if (p == 0) { lx1 = x; }
  if (p == 1) { lx2 = x; }
  if (p == 2) { lx3 = x; }
}
let c1 = lx1 * lx1 + 2.0 * (1.0 - mu) / abs(lx1 + mu) + 2.0 * mu / abs(lx1 - 1.0 + mu);
let c2 = lx2 * lx2 + 2.0 * (1.0 - mu) / abs(lx2 + mu) + 2.0 * mu / abs(lx2 - 1.0 + mu);
let c3 = lx3 * lx3 + 2.0 * (1.0 - mu) / abs(lx3 + mu) + 2.0 * mu / abs(lx3 - 1.0 + mu);
let l4x = 0.5 - mu;
let l4y = sqrt(3.0) / 2.0;
let c4 = l4x * l4x + l4y * l4y + 2.0 * (1.0 - mu) + 2.0 * mu;
assert_close(lx1, 0.836915, 0.000002);
assert_close(lx2, 1.155682, 0.000002);
assert_close(lx3, -1.005063, 0.000002);
assert_close(c1, 3.188341, 0.000005);
assert_close(c2, 3.172160, 0.000005);
assert_close(c3, 3.012147, 0.000005);
assert_close(c4, 2.987997, 0.000005);
print(str(lx1) + " " + str(lx2) + " " + str(lx3) + " " + str(l4x) + " " + str(l4y) + " " + str(c1) + " " + str(c2) + " " + str(c3) + " " + str(c4));
# Earth and Moon on their circular orbits (G = 1, separation 1, angular speed 1); test particles co-rotating:
# inertial velocity = omega x r. One sidereal month is 2 pi time units.
let earth = space.body("earth", 1.0 - mu, 0.0 - mu, 0.0, 0.0, 0.0, 0.0 - mu, 0.0);
let moon = space.body("moon", mu, 1.0 - mu, 0.0, 0.0, 0.0, 1.0 - mu, 0.0);
let a1 = lx1 - 0.000001;
let at1 = space.body("near L1", 0.000000000001, a1, 0.0, 0.0, 0.0, a1, 0.0);
let bx = l4x + 0.02;
let at4 = space.body("near L4", 0.000000000001, bx, l4y, 0.0, 0.0 - l4y, bx, 0.0);
let run = space.system().add(earth).add(moon).add(at1).add(at4).propagate(68.0, 4001, 0.001, "rk45", 0.000000000001);
run.save_csv("build/examples/lagrange.csv");
end _dsl_
savedsl(sim, "build/viz_lagrange-sim.dslb");
r = system ${dsl_cli(sim)} --dsl build/viz_lagrange-sim.dslb;
if (r.code != 0) { println(r.stdout); }
assert(r.code == 0);
println(r.stdout);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/lagrange.png", 1200, 760);
plot.cmd("set datafile separator ','");
plot.cmd("mu = 0.01215058560962404");
plot.cmd("C(x,y) = x**2 + y**2 + 2*(1-mu)/sqrt((x+mu)**2+y**2) + 2*mu/sqrt((x-1+mu)**2+y**2)");
plot.cmd("rx(x,y,t) = x*cos(t) + y*sin(t)");
plot.cmd("ry(x,y,t) = -x*sin(t) + y*cos(t)");
plot.cmd("set multiplot title 'Earth-Moon Lagrange points (lmspace): where a third body can stay put' font ',15'");
plot.cmd("set origin 0,0.12");
plot.cmd("set size 0.56,0.83");
plot.cmd("set title 'Zero-velocity curves at the Jacobi constants of L1, L2, L3 and L4'");
plot.cmd("set view map");
plot.cmd("set size ratio -1");
plot.cmd("unset surface");
plot.cmd("set contour base");
plot.cmd("set cntrparam levels discrete 3.188341, 3.172160, 3.012147, 2.9885");
plot.cmd("set isosamples 300,300");
plot.cmd("set samples 300,300");
plot.cmd("set xrange [-1.5:1.5]");
plot.cmd("set yrange [-1.5:1.5]");
plot.cmd("set xlabel 'x (rotating frame, in Earth-Moon distances)'");
plot.cmd("set ylabel 'y'");
plot.cmd("set key at screen 0.06,0.105 left Left reverse box opaque font ',10'");
plot.cmd("set grid front");
plot.cmd("set object 1 circle at -mu,0 size 0.06 fc rgb '#3b7dd8' fillstyle solid front");
plot.cmd("set object 2 circle at 1-mu,0 size 0.03 fc rgb '#9a9a9a' fillstyle solid front");
plot.cmd("set label 1 'L1' at 0.836915,0 center front point pt 7 ps 1.2 offset 0,1.1");
plot.cmd("set label 2 'L2' at 1.155682,0 center front point pt 7 ps 1.2 offset 0,1.1");
plot.cmd("set label 3 'L3' at -1.005063,0 center front point pt 7 ps 1.2 offset 0,1.1");
plot.cmd("set label 4 'L4' at 0.48785,0.866025 center front point pt 7 ps 1.2 offset 0,1.1");
plot.cmd("set label 5 'L5' at 0.48785,-0.866025 center front point pt 7 ps 1.2 offset 0,-1.1");
plot.cmd("set label 6 'Earth' at -0.01,-0.15 center front");
plot.cmd("set label 7 'Moon' at 0.99,-0.12 center front");
plot.cmd("set style line 1 lc rgb '#d62728' lw 2");
plot.cmd("set style line 2 lc rgb '#ff7f0e' lw 2");
plot.cmd("set style line 3 lc rgb '#2ca02c' lw 2");
plot.cmd("set style line 4 lc rgb '#9467bd' lw 2");
plot.cmd("set table 'build/examples/zvc.dat'");
plot.cmd("splot C(x,y) notitle");
plot.cmd("unset table");
plot.cmd("unset contour");
plot.cmd("set datafile separator whitespace");
plot.cmd("plot 'build/examples/zvc.dat' index 3 with lines ls 1 title 'C = C1: Earth and Moon regions touch at L1', '' index 2 with lines ls 2 title 'C = C2: the Moon region opens at L2', '' index 1 with lines ls 3 title 'C = C3: the forbidden zone opens at L3', '' index 0 with lines ls 4 title 'C just above C4: forbidden only near L4, L5'");
plot.cmd("set datafile separator ','");
plot.cmd("unset object 1");
plot.cmd("unset object 2");
plot.cmd("unset label");
plot.cmd("set origin 0.56,0.46");
plot.cmd("set size 0.44,0.49");
plot.cmd("set title 'Released at rest: L1 (red) escapes, L4 (purple) stays'");
plot.cmd("set xrange [-1.3:1.3]");
plot.cmd("set yrange [-1.3:1.3]");
plot.cmd("set xlabel 'x'");
plot.cmd("unset key");
plot.cmd("set object 3 circle at -mu,0 size 0.06 fc rgb '#3b7dd8' fillstyle solid front");
plot.cmd("set object 4 circle at 1-mu,0 size 0.03 fc rgb '#9a9a9a' fillstyle solid front");
plot.cmd("plot 'build/examples/lagrange.csv' using (rx($14,$15,$1)):(ry($14,$15,$1)) with lines lw 1.5 lc rgb '#d62728' title '1e-6 from L1', '' using (rx($20,$21,$1)):(ry($20,$21,$1)) with lines lw 1.5 lc rgb '#9467bd' title '0.02 from L4'");
plot.cmd("unset object 3");
plot.cmd("unset object 4");
plot.cmd("set origin 0.56,0");
plot.cmd("set size 0.44,0.45");
plot.cmd("set size noratio");
plot.cmd("set title 'Distance from the starting point'");
plot.cmd("set logscale y");
plot.cmd("set format y '10^{%L}'");
plot.cmd("set xrange [0:300]");
plot.cmd("set yrange [1e-7:3]");
plot.cmd("set xlabel 'time [days]'");
plot.cmd("set ylabel 'distance [Earth-Moon units]'");
plot.cmd("unset key");
plot.cmd("plot 'build/examples/lagrange.csv' using ($1*27.32/(2*pi)):(sqrt((rx($14,$15,$1)-0.836914)**2 + ry($14,$15,$1)**2)) with lines lw 2 lc rgb '#d62728', '' using ($1*27.32/(2*pi)):(sqrt((rx($20,$21,$1)-0.50785)**2 + (ry($20,$21,$1)-0.866025)**2)) with lines lw 2 lc rgb '#9467bd'");
plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(draw, "build/viz_lagrange-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/viz_lagrange-draw.dslb;
if (r.code != 0) { println(r.stdout); }
assert(r.code == 0);
println("wrote images/lagrange.png");
