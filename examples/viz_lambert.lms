# Lambert's problem: all the ways to fly from (1, 0) to (-0.5, 1.2) around a unit central mass (mu = 1) in a given
# time. lambert() returns the departure and arrival velocities for each time of flight; the script propagates the
# departure state with RK45 and asserts it lands on the target with the predicted arrival velocity.
# Output: images/lambert.png   (run: lmctl autorun <raw url of this file>)
mkdir("build/examples");
mkdir("images");
sim = _dsl_ cli="lmspace" install="github:lmctl-ai/lmspace@latest";
let q_l1 = lambert(vector(1.0, 0.0, 0.0), vector(-0.5, 1.2, 0.0), 1.2, 1.0, true);
let sun_l1 = space.body("sun", 1.0);
let probe_l1 = space.body("probe", 0.000000000001, 1.0, 0.0, 0.0, q_l1.get(0, 0), q_l1.get(0, 1), q_l1.get(0, 2));
let o_l1 = space.system().add(sun_l1).add(probe_l1).propagate(1.2, 300, 0.002, "rk45", 0.000000000001);
assert_close(o_l1.get(299, 7), -0.5, 0.000001);
assert_close(o_l1.get(299, 8), 1.2, 0.000001);
assert_close(o_l1.get(299, 10), q_l1.get(1, 0), 0.000001);
assert_close(o_l1.get(299, 11), q_l1.get(1, 1), 0.000001);
o_l1.save_csv("build/examples/lambert_l1.csv");
let q_l2 = lambert(vector(1.0, 0.0, 0.0), vector(-0.5, 1.2, 0.0), 1.8, 1.0, true);
let sun_l2 = space.body("sun", 1.0);
let probe_l2 = space.body("probe", 0.000000000001, 1.0, 0.0, 0.0, q_l2.get(0, 0), q_l2.get(0, 1), q_l2.get(0, 2));
let o_l2 = space.system().add(sun_l2).add(probe_l2).propagate(1.8, 300, 0.002, "rk45", 0.000000000001);
assert_close(o_l2.get(299, 7), -0.5, 0.000001);
assert_close(o_l2.get(299, 8), 1.2, 0.000001);
assert_close(o_l2.get(299, 10), q_l2.get(1, 0), 0.000001);
assert_close(o_l2.get(299, 11), q_l2.get(1, 1), 0.000001);
o_l2.save_csv("build/examples/lambert_l2.csv");
let q_l3 = lambert(vector(1.0, 0.0, 0.0), vector(-0.5, 1.2, 0.0), 2.6, 1.0, true);
let sun_l3 = space.body("sun", 1.0);
let probe_l3 = space.body("probe", 0.000000000001, 1.0, 0.0, 0.0, q_l3.get(0, 0), q_l3.get(0, 1), q_l3.get(0, 2));
let o_l3 = space.system().add(sun_l3).add(probe_l3).propagate(2.6, 300, 0.002, "rk45", 0.000000000001);
assert_close(o_l3.get(299, 7), -0.5, 0.000001);
assert_close(o_l3.get(299, 8), 1.2, 0.000001);
assert_close(o_l3.get(299, 10), q_l3.get(1, 0), 0.000001);
assert_close(o_l3.get(299, 11), q_l3.get(1, 1), 0.000001);
o_l3.save_csv("build/examples/lambert_l3.csv");
let q_l4 = lambert(vector(1.0, 0.0, 0.0), vector(-0.5, 1.2, 0.0), 3.8, 1.0, true);
let sun_l4 = space.body("sun", 1.0);
let probe_l4 = space.body("probe", 0.000000000001, 1.0, 0.0, 0.0, q_l4.get(0, 0), q_l4.get(0, 1), q_l4.get(0, 2));
let o_l4 = space.system().add(sun_l4).add(probe_l4).propagate(3.8, 300, 0.002, "rk45", 0.000000000001);
assert_close(o_l4.get(299, 7), -0.5, 0.000001);
assert_close(o_l4.get(299, 8), 1.2, 0.000001);
assert_close(o_l4.get(299, 10), q_l4.get(1, 0), 0.000001);
assert_close(o_l4.get(299, 11), q_l4.get(1, 1), 0.000001);
o_l4.save_csv("build/examples/lambert_l4.csv");
let q_l5 = lambert(vector(1.0, 0.0, 0.0), vector(-0.5, 1.2, 0.0), 5.5, 1.0, true);
let sun_l5 = space.body("sun", 1.0);
let probe_l5 = space.body("probe", 0.000000000001, 1.0, 0.0, 0.0, q_l5.get(0, 0), q_l5.get(0, 1), q_l5.get(0, 2));
let o_l5 = space.system().add(sun_l5).add(probe_l5).propagate(5.5, 300, 0.002, "rk45", 0.000000000001);
assert_close(o_l5.get(299, 7), -0.5, 0.000001);
assert_close(o_l5.get(299, 8), 1.2, 0.000001);
assert_close(o_l5.get(299, 10), q_l5.get(1, 0), 0.000001);
assert_close(o_l5.get(299, 11), q_l5.get(1, 1), 0.000001);
o_l5.save_csv("build/examples/lambert_l5.csv");
end _dsl_
savedsl(sim, "build/viz_lambert-sim.dslb");
r = system ${dsl_cli(sim)} --dsl build/viz_lambert-sim.dslb;
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/lambert.png", 900, 720);
plot.cmd("set datafile separator ','");
plot.cmd("set title 'Lambert arcs between two fixed points for five flight times (lmspace)'");
plot.cmd("set xlabel 'x'");
plot.cmd("set ylabel 'y'");
plot.cmd("set size ratio -1");
plot.cmd("set grid");
plot.cmd("set key bottom left box opaque");
plot.cmd("set object 1 circle at 0,0 size 0.08 fc rgb '#ffcc00' fillstyle solid border rgb 'black'");
plot.cmd("set yrange [-0.2:1.95]");
plot.cmd("set xrange [-0.7:1.4]");
plot.cmd("set label 1 'start' at 1.04,-0.1");
plot.cmd("set label 2 'target' at -0.62,1.32");
plot.cmd("plot 'build/examples/lambert_l1.csv' using 8:9 with lines lw 3 lc rgb '#1f77b4' title 'flight time 1.2', 'build/examples/lambert_l2.csv' using 8:9 with lines lw 3 lc rgb '#2ca02c' title 'flight time 1.8', 'build/examples/lambert_l3.csv' using 8:9 with lines lw 3 lc rgb '#ff7f0e' title 'flight time 2.6', 'build/examples/lambert_l4.csv' using 8:9 with lines lw 3 lc rgb '#d62728' title 'flight time 3.8', 'build/examples/lambert_l5.csv' using 8:9 with lines lw 3 lc rgb '#9467bd' title 'flight time 5.5', 'build/examples/lambert_l1.csv' every ::0::0 using 8:9 with points pt 7 ps 2 lc rgb 'black' notitle, '' every ::299::299 using 8:9 with points pt 9 ps 2 lc rgb 'black' notitle");
plot.close();
end _dsl_
savedsl(draw, "build/lambert-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/lambert-draw.dslb;
assert(r.code == 0);
println("wrote images/lambert.png");
