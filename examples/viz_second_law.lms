# Kepler's second law: a body on an e = 0.7 orbit sampled at 24 equal time steps over one period. The spokes from the
# focus cut the ellipse into sectors of equal area; the script checks that the angular momentum is the same at every
# sample and that the body is back at perigee after one period.
# Output: images/second_law.png   (run: lmctl autorun <raw url of this file>)
mkdir("build/examples");
mkdir("images");
sim = _lmcode_ cli="lmspace" install="github:lmctl-ai/lmspace@latest";
let sun = space.body("sun", 1.0);
let rock = space.body("rock", 0.000000000001, 0.3, 0.0, 0.0, 0.0, sqrt(1.7 / 0.3), 0.0);
let sys = space.system().add(sun).add(rock);
let dots = sys.propagate(2.0 * 3.141592653589793, 25, 0.0005, "rk45", 0.000000000001);
let ell = sys.propagate(2.0 * 3.141592653589793, 400, 0.0005, "rk45", 0.000000000001);
let l0 = dots.get(0, 7) * dots.get(0, 11) - dots.get(0, 8) * dots.get(0, 10);
for (k in range(1, 25)) {
  let lk = dots.get(k, 7) * dots.get(k, 11) - dots.get(k, 8) * dots.get(k, 10);
  assert_close(lk, l0, 0.000001);
}
assert_close(dots.get(24, 7), 0.3, 0.00001);
assert_close(dots.get(24, 8), 0.0, 0.00001);
dots.save_csv("build/examples/second_law_dots.csv");
ell.save_csv("build/examples/second_law_orbit.csv");
end _lmcode_
savedsl(sim, "build/viz_second_law-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode build/viz_second_law-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/second_law.png", 900, 700);
plot.cmd("set datafile separator ','");
plot.cmd("set title 'Second law of Kepler: 24 equal time steps sweep 24 equal areas (e = 0.7, lmspace)'");
plot.cmd("set xlabel 'x'");
plot.cmd("set ylabel 'y'");
plot.cmd("set size ratio -1");
plot.cmd("set grid");
plot.cmd("set object 1 circle at 0,0 size 0.04 fc rgb '#ffcc00' fillstyle solid border rgb 'black'");
plot.cmd("set key off");
plot.cmd("set xrange [-1.9:0.5]");
plot.cmd("set yrange [-0.9:0.9]");
plot.cmd("plot 'build/examples/second_law_orbit.csv' using 8:9 with lines lw 2 lc rgb '#1f77b4', 'build/examples/second_law_dots.csv' using (0):(0):8:9 with vectors nohead lc rgb '#888888', 'build/examples/second_law_dots.csv' using 8:9 with points pt 7 ps 1.5 lc rgb '#d62728'");
plot.close();
end _lmcode_
savedsl(draw, "build/second_law-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode build/second_law-draw.dslb;
assert(r.code == 0);
println("wrote images/second_law.png");
