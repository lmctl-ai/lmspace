p = _lmcode_ cli="lmspace" install="github:lmctl-ai/lmspace@latest";
space.load_kernel("build/synthetic-host.bsp");
let r = space.ephemeris("1000001", "0", "J2000", 5.0);
assert_close(float(r.rows()), 1.0, 0.0);
assert_close(float(r.cols()), 6.0, 0.0);
assert_close(r.get(0,0), 105.0, 0.000000001);
assert_close(r.get(0,1), 210.0, 0.000000001);
assert_close(r.get(0,2), 315.0, 0.000000001);
assert_close(r.get(0,3), 1.0, 0.000000001);
assert_close(r.get(0,4), 2.0, 0.000000001);
assert_close(r.get(0,5), 3.0, 0.000000001);
space.clear_kernels();
end _lmcode_
savedsl(p, "build/ephemeris.dslb");
